# Copiar a .env y generar valores propios. No versionar .env.
POSTGRES_DB=fashionstore_p2
POSTGRES_USER=fashionstore_owner
POSTGRES_PASSWORD=change-owner-password
APP_DB_PASSWORD=change-app-password
APP_DB_USER=fashionstore_app
SECRET_KEY=replace-with-a-random-secret-of-at-least-48-characters
DEMO_PASSWORD=replace-with-a-demo-password-at-least-12-characters
GOOGLE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FIREBASE_CREDENTIALS_FILE=
# Desarrollo local con Docker. Producción nativa: infra/native y docs/DESPLIEGUE_NATIVO.md.
MIGRATION_HOST=127.0.0.1
MIGRATION_PORT=55433
