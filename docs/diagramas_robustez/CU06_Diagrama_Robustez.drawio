        <mxCell id="title_text" value="&amp;lt;font color='#FFFFFF' style='font-size:26px;font-weight:bold;'&amp;gt;DIAGRAMA DE ROBUSTEZ (ICONIX): CU06 - ADMINISTRAR CATÁLOGO DE PRENDAS&amp;lt;/font&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color='#94A3B8' style='font-size:15px;'&amp;gt;FashionStore SaaS · Arquitectura de Casos de Uso del 2do Parcial · Separación Estricta: Actores, Fronteras, Controles y Entidades&amp;lt;/font&amp;gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1" connectable="0">
